# Elasticsearch. On Elastic Cloud use the endpoint + an API key.
# Optional: CREDS_FILE=/path/to/another.env
ES_URL=https://your-deployment.es.us-central1.gcp.cloud.es.io
ES_API_KEY=
KIBANA_URL=https://your-deployment.kb.us-central1.gcp.cloud.es.io
# Claude (optional; without it a rule-based parser is used)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
DEFAULT_STORE=store-1001
PORT=8080
